[Unit]
Description=Godot Tug-of-War Game Server (WebSocket host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/tugofwar
ExecStart=/usr/local/bin/godot --headless --path /opt/tugofwar -- --server
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target