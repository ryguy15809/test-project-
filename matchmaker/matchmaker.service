[Unit]
Description=Godot Tug-of-War Matchmaker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matchmaker
Group=matchmaker
WorkingDirectory=/opt/matchmaker
# Use the correct Godot linux binary path (x86_64 or arm64 depending on your VM shape).
ExecStart=/usr/local/bin/godot --headless --path /opt/matchmaker
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
